<section class="nsic-report-full-wrapper">

    <h1 id="wb-cont">Annex&nbsp;A&nbsp;-&nbsp;The <abbr title='Canadian Citizens'>CANCIT</abbr> Functional Directive<br><small>Special Report on the Collection, Use, Retention and Dissemination of Information on Canadians in the context of the Department of National Defence and the Canadian Armed Forces Defence Intelligence Activities</small></h1>

    




<div class="nsic-report-nav">
    <div class="row">
        <div class="col-xs-4 nsic-report-nav-prev">
            
